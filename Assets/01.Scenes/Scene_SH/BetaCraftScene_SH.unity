    - target: {fileID: 8383344148730722992, guid: 9392a7e58d4c142e4ba373a8efc05e26, type: 3}
      propertyPath: m_text
      value: "\uAE4A\uC740 \uC9C0\uD558\uC5D0\uC11C \uCC44\uAD74 \uD6C4 \uB4DC\uC6CC\uD504
        \uC804\uC0AC\uB4E4\uC774 \uBA39\uB358 \uC804\uD1B5\uC758 \uD30C\uC774. \uC678\uD615\uC740
        \uD22C\uBC15\uD558\uC9C0\uB9CC \uC548\uC5D0\uB294 \uB2E8\uB2E8\uD55C \uACE1\uBB3C\uACFC
        \uACE0\uAE30, \uACAC\uACFC\uB958\uAC00 \uCD18\uCD18\uD788 \uCC44\uC6CC\uC838
        \uC788\uB2E4. \uD55C \uC785 \uBCA0\uC5B4 \uBB3C\uBA74 \uC9C4\uB4DD\uD558\uACE0
        \uAC15\uD55C \uD48D\uBBF8\uAC00 \uD37C\uC9C0\uBA70, \uBAB8 \uC18D \uAE4A\uC740
        \uACF3\uC5D0\uC11C\uBD80\uD130 \uD798\uC774 \uC19F\uB294\uB2E4."
      objectReference: {fileID: 0}
